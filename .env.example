# KitSetups Backend Environment Variables
# Copy this to .env and fill in your values

# === REQUIRED ===

# Firebase Service Account (base64-encoded JSON)
# Generate from Firebase Console → Project Settings → Service Accounts
# Then: cat service-account.json | base64 -w 0
FIREBASE_SERVICE_ACCOUNT_BASE64=

# === OPTIONAL ===

# Server port (default: 8787)
PORT=8787

# Frontend URL for CORS (default: * for all origins)
FRONTEND_URL=https://kitsetups.xyz

# Node environment
NODE_ENV=development

# === INTERNAL ===
# These are typically set by deployment platform

LOG_LEVEL=info
DEBUG=false
